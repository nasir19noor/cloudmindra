---
import '../styles/global.css';

const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.cloudmindra.com';

const ranges = [
  { days: 1, label: 'Today' },
  { days: 7, label: '7 days' },
  { days: 30, label: '30 days' },
  { days: 90, label: '90 days' },
];

const panels = [
  { key: 'pages', title: 'Top pages' },
  { key: 'referrers', title: 'Referrers' },
  { key: 'countries', title: 'Countries' },
  { key: 'cities', title: 'Cities' },
  { key: 'devices', title: 'Devices' },
  { key: 'browsers', title: 'Browsers' },
  { key: 'os', title: 'Operating systems' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@300;400&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Admin | CloudMindra</title>
  </head>
  <body data-api={API_URL}>
    <!-- Loading -->
    <div id="view-loading" class="flex min-h-screen items-center justify-center text-body text-fg/60">Loading…</div>

    <!-- Login -->
    <div id="view-login" class="hidden min-h-screen items-center justify-center px-6">
      <div class="card w-full max-w-[380px] space-y-5 p-8">
        <div class="flex items-center gap-2.5 font-display text-[19px]">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="10" stroke="#ff6b35" stroke-width="2.5"></circle>
            <circle cx="16" cy="16" r="3.5" fill="#111111"></circle>
          </svg>
          CloudMindra Admin
        </div>
        <a
          href={`${API_URL}/api/auth/login?provider=google&next=/admin`}
          class="flex h-[44px] w-full items-center justify-center gap-3 rounded-full bg-fg text-body font-medium text-canvas transition-opacity hover:opacity-90"
        >
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"></path>
            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"></path>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"></path>
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"></path>
          </svg>
          Continue with Google
        </a>
        <a href={`${API_URL}/api/auth/login?next=/admin`} class="btn-secondary h-[44px] w-full">Sign in with email</a>
        <p id="login-error" class="hidden text-center text-caption text-red-600" role="alert"></p>
      </div>
    </div>

    <!-- Dashboard -->
    <div id="view-dashboard" class="hidden">
      <header class="sticky top-0 z-40 border-b border-fg/[0.08] bg-canvas/85 backdrop-blur-xl">
        <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-6">
          <a href="/" class="flex items-center gap-2.5 font-display text-[18px]">
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <circle cx="16" cy="16" r="10" stroke="#ff6b35" stroke-width="2.5"></circle>
              <circle cx="16" cy="16" r="3.5" fill="#111111"></circle>
            </svg>
            <span>CloudMindra <span class="text-fg/55">Admin</span></span>
          </a>
          <div class="flex items-center gap-3">
            <span id="admin-user" class="hidden text-caption text-fg/60 sm:inline"></span>
            <button id="logout" class="btn-secondary h-[34px] px-4 text-caption">Sign out</button>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-[1200px] px-6 py-10">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow mb-3">Analytics</p>
            <h1 class="font-display text-display-sm font-light">Visitors</h1>
          </div>
          <div id="range" class="inline-flex self-start rounded-full bg-fg/[0.05] p-1 ring-1 ring-fg/[0.08] md:self-auto">
            {ranges.map((r) => (
              <button
                data-days={r.days}
                class="range-btn rounded-full px-4 py-1.5 text-caption font-medium text-fg/60 transition-colors hover:text-fg"
              >
                {r.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Health warnings (from /api/admin/system) -->
        <div id="health-banner" class="mt-6 hidden rounded-2xl bg-amber-50 px-5 py-4 text-caption text-amber-900 ring-1 ring-amber-200" role="alert"></div>

        <!-- KPIs -->
        <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
          {[
            ['visits', 'Page views'],
            ['visitors', 'Unique visitors'],
            ['pages_per_visitor', 'Pages / visitor'],
            ['contacts', 'Contact messages'],
          ].map(([key, label]) => (
            <div class="card p-6">
              <p class="eyebrow">{label}</p>
              <p data-kpi={key} class="mt-4 font-display text-[36px] font-light leading-none">–</p>
            </div>
          ))}
        </div>

        <!-- Daily chart -->
        <section class="card mt-4 p-6">
          <div class="flex items-center justify-between">
            <p class="eyebrow">Daily traffic</p>
            <div class="flex items-center gap-4 text-caption text-fg/60">
              <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-fg/80"></span>Page views</span>
              <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-brand"></span>Visitors</span>
            </div>
          </div>
          <div id="chart" class="relative mt-6 h-[220px]"></div>
          <div id="chart-axis" class="mt-2 flex justify-between text-[11px] text-fg/50"></div>
        </section>

        <!-- Breakdowns -->
        <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {panels.map((p) => (
            <section class="card p-6">
              <p class="eyebrow">{p.title}</p>
              <ul data-panel={p.key} class="mt-5 space-y-3"></ul>
            </section>
          ))}
        </div>

        <!-- Users and admin access -->
        <section class="card mt-4 overflow-hidden">
          <div class="flex items-center justify-between gap-4 p-6 pb-4">
            <p class="eyebrow">Users <span id="users-count" class="text-fg/45"></span></p>
            <p class="text-caption text-fg/55">Admins can open this dashboard</p>
          </div>
          <p id="users-error" class="hidden px-6 pb-4 text-caption text-red-600" role="alert"></p>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] text-left text-[13px]">
              <thead class="border-y border-fg/[0.08] text-[11px] uppercase tracking-[0.1em] text-fg/55">
                <tr>
                  <th class="px-6 py-3 font-medium">User</th>
                  <th class="px-3 py-3 font-medium">Signed in with</th>
                  <th class="px-3 py-3 font-medium">Joined</th>
                  <th class="px-3 py-3 font-medium">Last login</th>
                  <th class="px-6 py-3 text-right font-medium">Admin</th>
                </tr>
              </thead>
              <tbody id="users" class="divide-y divide-fg/[0.06]"></tbody>
            </table>
          </div>
        </section>

        <!-- Workspaces and seat limits -->
        <section class="card mt-4 overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-4 p-6 pb-4">
            <p class="eyebrow">Workspaces <span id="orgs-count" class="text-fg/45"></span></p>
            <p class="text-caption text-fg/55">Seats = members + pending invitations. Leave the limit empty to use the default.</p>
          </div>
          <p id="orgs-msg" class="hidden px-6 pb-4 text-caption" role="status"></p>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[960px] text-left text-[13px]">
              <thead class="border-y border-fg/[0.08] text-[11px] uppercase tracking-[0.1em] text-fg/55">
                <tr>
                  <th class="px-6 py-3 font-medium">Workspace</th>
                  <th class="px-3 py-3 font-medium">Owner</th>
                  <th class="px-3 py-3 font-medium">Seats used</th>
                  <th class="px-3 py-3 font-medium">Modules</th>
                  <th class="px-3 py-3 font-medium">Created</th>
                  <th class="px-6 py-3 text-right font-medium">Seat limit</th>
                </tr>
              </thead>
              <tbody id="orgs" class="divide-y divide-fg/[0.06]"></tbody>
            </table>
          </div>
        </section>

        <!-- System health -->
        <section class="card mt-4 p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="eyebrow">System health <span id="health-status" class="ml-2 rounded-full px-2 py-0.5 text-[10px]"></span></p>
            <button id="health-refresh" class="btn-secondary h-[30px] px-3 text-[12px]">Refresh</button>
          </div>
          <div id="health" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"></div>
        </section>

        <!-- Jobs -->
        <section class="card mt-4 overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 p-6 pb-4">
            <p class="eyebrow">Jobs</p>
            <div class="flex flex-wrap items-center gap-2">
              <select id="jobs-status" class="field h-[34px] w-auto py-0 text-[13px]" aria-label="Job status">
                <option value="">All statuses</option>
                <option value="failed" selected>Failed</option>
                <option value="queued">Queued</option>
                <option value="running">Running</option>
                <option value="succeeded">Succeeded</option>
                <option value="cancelled">Cancelled</option>
              </select>
              <input id="jobs-type" placeholder="Type, e.g. notify.email" class="field h-[34px] w-[200px] py-0 text-[13px]" aria-label="Job type" />
            </div>
          </div>
          <p id="jobs-msg" class="hidden px-6 pb-4 text-caption" role="status"></p>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[900px] text-left text-[13px]">
              <thead class="border-y border-fg/[0.08] text-[11px] uppercase tracking-[0.1em] text-fg/55">
                <tr>
                  <th class="px-6 py-3 font-medium">Created</th>
                  <th class="px-3 py-3 font-medium">Type</th>
                  <th class="px-3 py-3 font-medium">Workspace</th>
                  <th class="px-3 py-3 font-medium">Status</th>
                  <th class="px-3 py-3 font-medium">Error</th>
                  <th class="px-6 py-3 text-right font-medium">Action</th>
                </tr>
              </thead>
              <tbody id="jobs" class="divide-y divide-fg/[0.06]"></tbody>
            </table>
          </div>
        </section>

        <!-- Platform activity -->
        <section class="card mt-4 p-6">
          <p class="eyebrow">Platform activity</p>
          <p class="mt-2 text-caption text-fg/55">Audit log across all workspaces, newest first.</p>
          <ul id="platform-activity" class="mt-5 max-h-[420px] divide-y divide-fg/[0.06] overflow-y-auto rounded-2xl ring-1 ring-fg/[0.08]"></ul>
        </section>

        <!-- Contact submissions -->
        <section class="card mt-4 overflow-hidden">
          <div class="p-6 pb-4"><p class="eyebrow">Contact messages</p></div>
          <div id="contacts" class="divide-y divide-fg/[0.06] border-t border-fg/[0.08]"></div>
        </section>
        <!-- Recent visits -->
        <section class="card mt-4 overflow-hidden">
          <div class="p-6 pb-4"><p class="eyebrow">Recent visits</p></div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] text-left text-[13px]">
              <thead class="border-y border-fg/[0.08] text-[11px] uppercase tracking-[0.1em] text-fg/55">
                <tr>
                  <th class="px-6 py-3 font-medium">Time</th>
                  <th class="px-3 py-3 font-medium">Page</th>
                  <th class="px-3 py-3 font-medium">Location</th>
                  <th class="px-3 py-3 font-medium">Device</th>
                  <th class="px-3 py-3 font-medium">Referrer</th>
                  <th class="px-6 py-3 font-medium">IP</th>
                </tr>
              </thead>
              <tbody id="recent" class="divide-y divide-fg/[0.06]"></tbody>
            </table>
          </div>
          <button id="recent-more" class="hidden w-full border-t border-fg/[0.08] py-3 text-caption font-medium text-fg/70 transition-colors hover:bg-fg/[0.03] hover:text-fg"></button>
        </section>

      </main>
    </div>
    <dialog id="plan-dialog" class="w-[min(520px,92vw)] rounded-2xl p-0 backdrop:bg-black/30">
      <form id="plan-form" method="dialog" class="space-y-4 p-6">
        <div>
          <p class="eyebrow">Edit plan</p>
          <p id="plan-title" class="mt-1 text-body font-medium"></p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-caption text-fg/70">Tier
            <select name="tier" class="field mt-1"><option value="free">Free</option><option value="pro">Pro</option></select>
          </label>
          <label class="block text-caption text-fg/70">Pro until (optional)
            <input name="pro_until" type="date" class="field mt-1" />
          </label>
        </div>
        <div>
          <p class="text-caption font-medium text-fg/70">Limit overrides <span class="font-normal text-fg/50">(empty = tier default)</span></p>
          <div id="plan-limits" class="mt-2 space-y-2"></div>
        </div>
        <p id="plan-msg" class="hidden text-caption" role="status"></p>
        <div class="flex justify-end gap-2">
          <button value="cancel" formnovalidate class="btn-secondary h-[38px] px-4 text-caption">Cancel</button>
          <button id="plan-save" value="save" class="h-[38px] rounded-full bg-fg px-5 text-caption font-medium text-canvas">Save</button>
        </div>
      </form>
    </dialog>
  </body>
</html>

<script>
  import { renderActivity } from '../lib/portal';

  const API = document.body.dataset.api as string;
  let days = 30;

  type Row = { label: string; visits: number };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  // All visitor-supplied values go through esc() before touching innerHTML
  const esc = (v: unknown) =>
    String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const fmtNum = (n: number) => new Intl.NumberFormat().format(n);
  const fmtTime = (iso: string | null) =>
    iso ? new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '–';

  function show(view: 'loading' | 'login' | 'dashboard') {
    for (const v of ['loading', 'login', 'dashboard']) {
      const el = $(`#view-${v}`);
      el.classList.toggle('hidden', v !== view);
      el.classList.toggle('flex', v === view && v !== 'dashboard');
    }
  }

  async function api(path: string, init: RequestInit = {}) {
    return fetch(`${API}${path}`, {
      credentials: 'include',
      ...init,
      headers: { 'Content-Type': 'application/json', ...(init.headers || {}) },
    });
  }

  function renderList(key: string, rows: Row[]) {
    const ul = $(`[data-panel="${key}"]`);
    if (!rows.length) {
      ul.innerHTML = '<li class="text-caption text-fg/50">No data yet</li>';
      return;
    }
    const max = Math.max(...rows.map((r) => r.visits));
    ul.innerHTML = rows
      .map(
        (r) => `
        <li>
          <div class="flex items-center justify-between gap-3 text-[13px]">
            <span class="truncate text-fg/80" title="${esc(r.label)}">${esc(r.label)}</span>
            <span class="shrink-0 font-medium tabular-nums">${fmtNum(r.visits)}</span>
          </div>
          <div class="mt-1.5 h-1 rounded-full bg-fg/[0.06]">
            <div class="h-1 rounded-full bg-brand/80" style="width:${Math.max(2, (r.visits / max) * 100)}%"></div>
          </div>
        </li>`,
      )
      .join('');
  }

  function renderChart(daily: { date: string; visits: number; visitors: number }[]) {
    const max = Math.max(1, ...daily.map((d) => d.visits));
    const chart = $('#chart');
    chart.innerHTML = `
      <div class="absolute inset-0 flex items-end gap-[2px]">
        ${daily
          .map(
            (d) => `
          <div class="group relative flex h-full flex-1 items-end justify-center">
            <div class="w-full max-w-[28px] rounded-t-[3px] bg-fg/80 transition-opacity group-hover:opacity-70" style="height:${(d.visits / max) * 100}%"></div>
            <div class="absolute bottom-0 h-[3px] w-full max-w-[28px] rounded-full bg-brand" style="bottom:${(d.visitors / max) * 100}%"></div>
            <div class="pointer-events-none absolute bottom-full z-10 mb-2 hidden whitespace-nowrap rounded-lg bg-fg px-2.5 py-1.5 text-[11px] text-canvas group-hover:block">
              ${esc(d.date)} · ${fmtNum(d.visits)} views · ${fmtNum(d.visitors)} visitors
            </div>
          </div>`,
          )
          .join('')}
      </div>`;
    const first = daily[0]?.date ?? '';
    const last = daily[daily.length - 1]?.date ?? '';
    $('#chart-axis').innerHTML = `<span>${esc(first)}</span><span>${esc(last)}</span>`;
  }

  const RECENT_PREVIEW = 20;
  let recentRows: any[] = [];
  let showAllRecent = false;

  function renderRecent(rows: any[] = recentRows) {
    recentRows = rows;
    const more = $('#recent-more');
    more.classList.toggle('hidden', rows.length <= RECENT_PREVIEW);
    more.textContent = showAllRecent ? 'Show less' : `Show all ${rows.length}`;
    if (!showAllRecent) rows = rows.slice(0, RECENT_PREVIEW);
    const tbody = $('#recent');
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-6 text-fg/50">No visits in this range</td></tr>';
      return;
    }
    tbody.innerHTML = rows
      .map((r) => {
        const loc = [r.city, r.country].filter(Boolean).join(', ') || '–';
        let ref = '–';
        if (r.referrer) {
          try {
            ref = new URL(r.referrer).host;
          } catch {
            ref = r.referrer;
          }
        }
        return `
        <tr class="text-fg/80">
          <td class="whitespace-nowrap px-6 py-3 text-fg/60">${esc(fmtTime(r.visited_at))}</td>
          <td class="max-w-[220px] truncate px-3 py-3 font-medium text-fg">${esc(r.path)}</td>
          <td class="px-3 py-3">${esc(loc)}</td>
          <td class="whitespace-nowrap px-3 py-3">${esc(r.device)} · ${esc(r.browser)} · ${esc(r.os)}</td>
          <td class="max-w-[180px] truncate px-3 py-3" title="${esc(r.referrer)}">${esc(ref)}</td>
          <td class="whitespace-nowrap px-6 py-3 font-mono text-[12px] text-fg/55">${esc(r.ip)}</td>
        </tr>`;
      })
      .join('');
  }

  async function loadContacts() {
    const box = $('#contacts');
    const res = await api('/api/contact');
    if (!res.ok) {
      box.innerHTML = '<p class="px-6 py-6 text-caption text-fg/50">Could not load messages</p>';
      return;
    }
    const rows = (await res.json()).slice(0, 50);
    if (!rows.length) {
      box.innerHTML = '<p class="px-6 py-6 text-caption text-fg/50">No messages yet</p>';
      return;
    }
    box.innerHTML = rows
      .map(
        (c: any) => `
        <details class="group px-6 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
            <span class="min-w-0">
              <span class="font-medium">${esc(c.name)}</span>
              <span class="text-fg/60"> · ${esc(c.email)}${c.company ? ' · ' + esc(c.company) : ''}</span>
            </span>
            <span class="shrink-0 text-caption text-fg/55">${esc(fmtTime(c.created_at))}</span>
          </summary>
          <p class="mt-3 whitespace-pre-wrap text-body text-fg/75">${esc(c.message)}</p>
          <a href="mailto:${encodeURIComponent(c.email)}" class="mt-3 inline-block text-caption font-medium text-brand hover:underline">Reply by email →</a>
        </details>`,
      )
      .join('');
  }

  function orgsMsg(text: string | null, ok = false) {
    const el = $('#orgs-msg');
    el.textContent = text ?? '';
    el.classList.toggle('hidden', !text);
    el.classList.toggle('text-red-600', !ok);
    el.classList.toggle('text-emerald-700', ok);
  }

  async function loadWorkspaces() {
    const tbody = $('#orgs');
    const res = await api('/api/admin/orgs');
    if (!res.ok) {
      tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-6 text-fg/50">Could not load workspaces</td></tr>';
      return;
    }
    const rows = await res.json();
    orgRows = rows;
    $('#orgs-count').textContent = `· ${fmtNum(rows.length)}`;
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-6 text-fg/50">No workspaces yet</td></tr>';
      return;
    }
    tbody.innerHTML = rows
      .map((o: any) => {
        const used = o.members + o.pending_invites;
        const full = used >= o.effective_limit;
        return `
        <tr class="text-fg/80">
          <td class="px-6 py-3"><span class="font-medium text-fg">${esc(o.name)}</span></td>
          <td class="px-3 py-3">${o.owners.map((e: string) => esc(e)).join('<br>') || '–'}</td>
          <td class="whitespace-nowrap px-3 py-3">
            <span class="${full ? 'font-medium text-amber-700' : ''}">${fmtNum(used)} / ${fmtNum(o.effective_limit)}</span>
            <span class="block text-fg/50">${fmtNum(o.members)} members${o.pending_invites ? ` · ${fmtNum(o.pending_invites)} pending` : ''}</span>
          </td>
          <td class="px-3 py-3">
            ${Object.entries(o.modules)
              .map(
                ([key, m]: [string, any]) => `
              <label class="flex items-center gap-2 py-0.5">
                <span class="w-[110px] truncate">${esc(m.name)}</span>
                <select data-org="${esc(o.id)}" data-app="${esc(key)}" class="tier-select field h-[30px] w-[86px] py-0 text-[12px] ${
                  m.tier === 'pro' ? 'font-medium text-brand' : ''
                }" aria-label="${esc(m.name)} tier for ${esc(o.name)}">
                  <option value="free" ${m.tier === 'free' ? 'selected' : ''}>Free</option>
                  <option value="pro" ${m.tier === 'pro' ? 'selected' : ''}>Pro</option>
                </select>
                <button type="button" data-org="${esc(o.id)}" data-app="${esc(key)}" class="plan-edit text-[12px] font-medium text-brand hover:underline">Edit</button>
                ${Object.keys(m.overrides).length || m.pro_until ? '<span class="text-[11px] text-fg/50" title="Has an end date or limit overrides">•</span>' : ''}
              </label>`,
              )
              .join('')}
          </td>
          <td class="whitespace-nowrap px-3 py-3 text-fg/60">${esc(fmtTime(o.created_at))}</td>
          <td class="px-6 py-3">
            <form class="seat-form flex items-center justify-end gap-2" data-org="${esc(o.id)}">
              <input name="limit" type="number" min="1" max="1000" value="${o.member_limit ?? ''}"
                placeholder="${fmtNum(o.default_limit)} (default)" aria-label="Seat limit for ${esc(o.name)}"
                class="field h-[34px] w-[130px] py-0 text-[13px]" />
              <button class="btn-secondary h-[32px] px-3 text-[12px]">Save</button>
            </form>
          </td>
        </tr>`;
      })
      .join('');
  }

  // Switch a module between Free and Pro for one workspace (manual until billing exists)
  $('#orgs').addEventListener('change', async (e) => {
    const select = (e.target as HTMLElement).closest<HTMLSelectElement>('.tier-select');
    if (!select) return;
    const tier = select.value;
    const label = select.getAttribute('aria-label');
    if (!confirm(`Set ${label} to ${tier === 'pro' ? 'Pro' : 'Free'}?`)) {
      select.value = tier === 'pro' ? 'free' : 'pro';
      return;
    }
    select.disabled = true;
    orgsMsg(null);
    const res = await api(`/api/admin/orgs/${encodeURIComponent(select.dataset.org!)}/modules/${encodeURIComponent(select.dataset.app!)}`, {
      method: 'PUT',
      body: JSON.stringify({ tier }),
    }).catch(() => null);
    if (!res?.ok) {
      const body = res ? await res.json().catch(() => ({})) : {};
      orgsMsg(typeof body.detail === 'string' ? body.detail : 'Could not change the tier');
    } else {
      const o = await res.json();
      orgsMsg(`${o.name}: ${label?.split(' tier')[0]} is now ${tier === 'pro' ? 'Pro' : 'Free'}. Seats: ${o.effective_limit}.`, true);
    }
    await loadWorkspaces();
  });

  $('#orgs').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('.seat-form');
    if (!form) return;
    const raw = (form.elements.namedItem('limit') as HTMLInputElement).value.trim();
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    orgsMsg(null);
    const res = await api(`/api/admin/orgs/${encodeURIComponent(form.dataset.org!)}`, {
      method: 'PUT',
      body: JSON.stringify({ member_limit: raw === '' ? null : Number(raw) }),
    }).catch(() => null);
    btn.disabled = false;
    if (!res?.ok) {
      const body = res ? await res.json().catch(() => ({})) : {};
      const detail = typeof body.detail === 'string' ? body.detail : body.detail?.[0]?.msg;
      return orgsMsg(detail || 'Could not update the seat limit');
    }
    const o = await res.json();
    orgsMsg(`${o.name}: seat limit is now ${o.effective_limit}${o.member_limit == null ? ' (default)' : ''}.`, true);
    await loadWorkspaces();
  });

  // --- Plan dialog: tier, end date and limit overrides per workspace module ---------------
  let orgRows: any[] = [];
  let planTarget: { org: string; app: string } | null = null;

  function planMsg(text: string | null) {
    const el = $('#plan-msg');
    el.textContent = text ?? '';
    el.classList.toggle('hidden', !text);
    el.classList.toggle('text-red-600', !!text);
  }

  $('#orgs').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.plan-edit');
    if (!btn) return;
    const o = orgRows.find((r) => r.id === btn.dataset.org);
    const m = o?.modules[btn.dataset.app!];
    if (!o || !m) return;
    planTarget = { org: o.id, app: btn.dataset.app! };
    planMsg(null);
    $('#plan-title').textContent = `${m.name} · ${o.name}`;
    const form = $<HTMLFormElement>('#plan-form');
    (form.elements.namedItem('tier') as HTMLSelectElement).value = m.tier;
    (form.elements.namedItem('pro_until') as HTMLInputElement).value = m.pro_until ? m.pro_until.slice(0, 10) : '';
    $('#plan-limits').innerHTML = Object.entries(m.limits)
      .map(
        ([k, l]: [string, any]) => `
        <label class="flex items-center justify-between gap-3 text-caption text-fg/70">
          <span>${esc(l.label)} <span class="text-fg/45">(Free ${fmtNum(l.free)} · Pro ${fmtNum(l.pro)})</span></span>
          <input data-limit="${esc(k)}" type="number" min="0" value="${l.override ?? ''}" class="field h-[34px] w-[110px] py-0 text-[13px]" />
        </label>`,
      )
      .join('');
    $<HTMLDialogElement>('#plan-dialog').showModal();
  });

  $('#plan-save').addEventListener('click', async (e) => {
    e.preventDefault();
    if (!planTarget) return;
    const form = $<HTMLFormElement>('#plan-form');
    const tier = (form.elements.namedItem('tier') as HTMLSelectElement).value;
    const until = (form.elements.namedItem('pro_until') as HTMLInputElement).value;
    const limits: Record<string, number> = {};
    document.querySelectorAll<HTMLInputElement>('#plan-limits input[data-limit]').forEach((i) => {
      if (i.value.trim() !== '') limits[i.dataset.limit!] = Number(i.value);
    });
    const res = await api(`/api/admin/orgs/${encodeURIComponent(planTarget.org)}/modules/${encodeURIComponent(planTarget.app)}`, {
      method: 'PUT',
      // End of the chosen day, UTC; an empty date means no end date
      body: JSON.stringify({ tier, pro_until: until ? `${until}T23:59:59Z` : null, limits }),
    }).catch(() => null);
    if (!res?.ok) {
      const body = res ? await res.json().catch(() => ({})) : {};
      return planMsg(typeof body.detail === 'string' ? body.detail : 'Could not save the plan');
    }
    $<HTMLDialogElement>('#plan-dialog').close();
    orgsMsg('Plan saved.', true);
    await Promise.all([loadWorkspaces(), loadPlatformActivity()]);
  });

  // --- System health -------------------------------------------------------------------------
  const fmtAge = (sec: number | null) =>
    sec == null ? '–' : sec < 60 ? `${sec}s` : sec < 3600 ? `${Math.floor(sec / 60)} min` : `${Math.floor(sec / 3600)} h`;

  async function loadHealth() {
    const res = await api('/api/admin/system').catch(() => null);
    if (!res?.ok) return;
    const h = await res.json();
    const ok = h.status === 'ok';
    const status = $('#health-status');
    status.textContent = ok ? 'OK' : 'NEEDS ATTENTION';
    status.className = `ml-2 rounded-full px-2 py-0.5 text-[10px] ${ok ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900'}`;
    const banner = $('#health-banner');
    banner.innerHTML = h.warnings.map((w: string) => `<p>⚠ ${esc(w)}</p>`).join('');
    banner.classList.toggle('hidden', ok);

    const c = h.jobs.counts;
    const tile = (label: string, value: string, sub = '') =>
      `<div class="rounded-2xl p-4 ring-1 ring-fg/[0.08]"><p class="eyebrow">${label}</p><p class="mt-2 font-display text-[26px] font-light">${value}</p><p class="text-caption text-fg/55">${sub}</p></div>`;
    const uptime = h.modules.uptime ?? {};
    $('#health').innerHTML = [
      tile('Job queue', fmtNum(c.queued), `${fmtNum(c.running)} running · oldest due ${fmtAge(h.jobs.oldest_due_seconds)}`),
      tile('Failed jobs', fmtNum(c.failed), `${fmtNum(h.jobs.failed_24h)} in the last 24 h`),
      tile('Outbox', fmtNum(h.outbox.reduce((n: number, o: any) => n + o.unpublished, 0)),
        h.outbox.map((o: any) => `${esc(o.table)} ${o.unpublished}`).join(' · ')),
      tile('Uptime checks', fmtNum(uptime.active_monitors ?? 0),
        `active · ${uptime.overdue_monitors ?? 0} overdue · last ${uptime.last_check_at ? esc(fmtTime(uptime.last_check_at)) : 'never'}`),
    ].join('');
  }
  $('#health-refresh').addEventListener('click', () => Promise.all([loadHealth(), loadJobs()]));

  // --- Jobs --------------------------------------------------------------------------------
  const JOB_STATUS: Record<string, string> = {
    failed: 'bg-red-100 text-red-800', queued: 'bg-amber-100 text-amber-900', running: 'bg-sky-100 text-sky-800',
    succeeded: 'bg-emerald-100 text-emerald-800', cancelled: 'bg-fg/[0.06] text-fg/60',
  };

  function jobsMsg(text: string | null, ok = false) {
    const el = $('#jobs-msg');
    el.textContent = text ?? '';
    el.classList.toggle('hidden', !text);
    el.classList.toggle('text-red-600', !ok);
    el.classList.toggle('text-emerald-700', ok);
  }

  async function loadJobs() {
    const params = new URLSearchParams({ limit: '100' });
    const status = $<HTMLSelectElement>('#jobs-status').value;
    const type = $<HTMLInputElement>('#jobs-type').value.trim();
    if (status) params.set('status', status);
    if (type) params.set('type', type);
    const res = await api(`/api/admin/jobs?${params}`).catch(() => null);
    const tbody = $('#jobs');
    if (!res?.ok) {
      tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-6 text-fg/50">Could not load jobs</td></tr>';
      return;
    }
    const rows = await res.json();
    tbody.innerHTML = rows.length
      ? rows
          .map(
            (j: any) => `
        <tr class="align-top text-fg/80">
          <td class="whitespace-nowrap px-6 py-3 text-fg/60">${esc(fmtTime(j.created_at))}</td>
          <td class="px-3 py-3 font-mono text-[12px]">${esc(j.type)}${j.payload?.handler ? `<span class="block text-fg/50">${esc(j.payload.handler)}</span>` : ''}${j.payload?.to ? `<span class="block text-fg/50">${esc(j.payload.to)}</span>` : ''}</td>
          <td class="px-3 py-3">${esc(j.org_name ?? '–')}</td>
          <td class="whitespace-nowrap px-3 py-3"><span class="rounded-full px-2 py-0.5 text-[11px] ${JOB_STATUS[j.status] ?? ''}">${esc(j.status)}</span>
            <span class="block text-fg/50">attempt ${j.attempts}/${j.max_attempts}</span></td>
          <td class="max-w-[320px] px-3 py-3"><span class="line-clamp-3 break-words text-fg/70" title="${esc(j.error_full ?? '')}">${esc(j.error ?? '')}</span></td>
          <td class="px-6 py-3 text-right">
            ${j.status === 'failed' || j.status === 'cancelled' ? `<button data-job="${esc(j.id)}" data-op="retry" class="btn-secondary h-[30px] px-3 text-[12px]">Retry</button>` : ''}
            ${j.status === 'queued' ? `<button data-job="${esc(j.id)}" data-op="cancel" class="btn-secondary h-[30px] px-3 text-[12px] text-red-600">Cancel</button>` : ''}
          </td>
        </tr>`,
          )
          .join('')
      : '<tr><td colspan="6" class="px-6 py-6 text-fg/50">No jobs match</td></tr>';
  }

  $('#jobs-status').addEventListener('change', loadJobs);
  $('#jobs-type').addEventListener('change', loadJobs);
  $('#jobs').addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-job]');
    if (!btn) return;
    btn.disabled = true;
    jobsMsg(null);
    const res = await api(`/api/admin/jobs/${encodeURIComponent(btn.dataset.job!)}/${btn.dataset.op}`, { method: 'POST' }).catch(() => null);
    if (!res?.ok) {
      const body = res ? await res.json().catch(() => ({})) : {};
      btn.disabled = false;
      return jobsMsg(typeof body.detail === 'string' ? body.detail : 'Could not update the job');
    }
    jobsMsg(btn.dataset.op === 'retry' ? 'Job queued again; the worker will pick it up within seconds.' : 'Job cancelled.', true);
    await Promise.all([loadJobs(), loadHealth(), loadPlatformActivity()]);
  });

  // --- Platform activity -------------------------------------------------------------------
  async function loadPlatformActivity() {
    const res = await api('/api/admin/activity?limit=100').catch(() => null);
    if (res?.ok) $('#platform-activity').innerHTML = renderActivity(await res.json());
  }

  async function loadUsers() {
    const tbody = $('#users');
    const res = await api('/api/admin/users');
    if (!res.ok) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-6 text-fg/50">Could not load users</td></tr>';
      return;
    }
    const rows = await res.json();
    $('#users-count').textContent = `· ${fmtNum(rows.length)}`;
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-6 text-fg/50">No one has signed in yet</td></tr>';
      return;
    }
    tbody.innerHTML = rows
      .map(
        (u: any) => `
        <tr class="text-fg/80">
          <td class="px-6 py-3">
            <span class="font-medium text-fg">${esc(u.name || u.email)}</span>${u.is_self ? ' <span class="text-fg/50">(you)</span>' : ''}
            <span class="block text-fg/55">${esc(u.email)}</span>
          </td>
          <td class="px-3 py-3">${esc(u.provider)}</td>
          <td class="whitespace-nowrap px-3 py-3 text-fg/60">${esc(fmtTime(u.created_at))}</td>
          <td class="whitespace-nowrap px-3 py-3 text-fg/60">${esc(fmtTime(u.last_login_at))}</td>
          <td class="px-6 py-3 text-right">
            <button
              data-user="${esc(u.id)}"
              data-admin="${u.is_admin}"
              role="switch"
              aria-checked="${u.is_admin}"
              aria-label="Admin access for ${esc(u.email)}"
              ${u.is_self && u.is_admin ? 'disabled title="You cannot remove your own admin access"' : ''}
              class="admin-toggle relative inline-flex h-6 w-11 items-center rounded-full transition-colors disabled:cursor-not-allowed disabled:opacity-50 ${u.is_admin ? 'bg-brand' : 'bg-fg/15'}"
            >
              <span class="inline-block h-5 w-5 rounded-full bg-white shadow transition-transform ${u.is_admin ? 'translate-x-[22px]' : 'translate-x-[2px]'}"></span>
            </button>
          </td>
        </tr>`,
      )
      .join('');
  }

  $('#users').addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.admin-toggle');
    if (!btn || btn.disabled) return;
    const makeAdmin = btn.dataset.admin !== 'true';
    const err = $('#users-error');
    err.classList.add('hidden');
    btn.disabled = true;
    const res = await api(`/api/admin/users/${encodeURIComponent(btn.dataset.user!)}`, {
      method: 'PUT',
      body: JSON.stringify({ is_admin: makeAdmin }),
    }).catch(() => null);
    if (!res?.ok) {
      const body = res ? await res.json().catch(() => ({})) : {};
      err.textContent = body.detail || 'Could not update admin access';
      err.classList.remove('hidden');
    }
    await loadUsers();
  });

  async function loadAnalytics() {
    document.querySelectorAll<HTMLButtonElement>('.range-btn').forEach((b) => {
      const active = Number(b.dataset.days) === days;
      b.classList.toggle('bg-surface', active);
      b.classList.toggle('text-fg', active);
      b.classList.toggle('shadow-sm', active);
    });

    const res = await api(`/api/admin/analytics?days=${days}`);
    if (res.status === 401) return show('login');
    if (!res.ok) return;
    const data = await res.json();

    for (const [key, value] of Object.entries(data.totals)) {
      const el = document.querySelector(`[data-kpi="${key}"]`);
      if (el) el.textContent = fmtNum(value as number);
    }
    renderChart(data.daily);
    for (const key of ['pages', 'referrers', 'countries', 'cities', 'devices', 'browsers', 'os']) {
      renderList(key, data[key]);
    }
    renderRecent(data.recent);
  }

  async function enterDashboard(username: string) {
    $('#admin-user').textContent = username;
    show('dashboard');
    await Promise.all([loadAnalytics(), loadContacts(), loadUsers(), loadWorkspaces(), loadHealth(), loadJobs(), loadPlatformActivity()]);
  }

  $('#logout').addEventListener('click', async () => {
    await api('/api/admin/logout', { method: 'POST' }).catch(() => {});
    show('login');
  });

  $('#recent-more').addEventListener('click', () => {
    showAllRecent = !showAllRecent;
    renderRecent();
  });

  $('#range').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.range-btn');
    if (!btn) return;
    days = Number(btn.dataset.days);
    loadAnalytics();
  });

  function loginError(message: string) {
    const err = $('#login-error');
    err.textContent = message;
    err.classList.remove('hidden');
  }

  (async () => {
    const error = new URLSearchParams(location.search).get('error');
    if (error) {
      loginError(error === 'cancelled' ? 'Sign-in was cancelled.' : 'Sign-in failed. Please try again.');
      history.replaceState(null, '', location.pathname);
    }
    try {
      const res = await api('/api/admin/me');
      if (res.ok) {
        const { username } = await res.json();
        await enterDashboard(username);
        return;
      }
      // Signed in through Cognito but not an admin
      const user = await api('/api/auth/me');
      if (user.ok) {
        const { email } = await user.json();
        loginError(`${email} does not have admin access.`);
      }
      show('login');
    } catch {
      show('login');
    }
  })();
</script>
