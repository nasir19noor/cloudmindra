---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
---

<Layout title="Cloud & AI Solutions">
  <Hero />
  <Services />

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Transform Your Infrastructure?</h2>
      <p class="text-gray-500 mb-8 max-w-xl mx-auto">
        Let's discuss how CloudMindra can help you build scalable, secure, and intelligent systems.
      </p>
      <a
        href="/contact"
        class="inline-block bg-accent hover:bg-accent-dark text-white font-medium px-8 py-3.5 rounded-lg transition-colors"
      >
        Start a Conversation
      </a>
    </div>
  </section>
</Layout>
