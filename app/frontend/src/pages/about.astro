---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us" description="Learn about CloudMindra — our mission, values, and expertise in cloud and AI.">
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-4xl font-bold mb-6">About CloudMindra</h1>
      <p class="text-lg text-gray-600 mb-8 leading-relaxed">
        CloudMindra is a cloud and AI solutions company focused on helping businesses build, deploy, and scale modern infrastructure. We combine deep expertise in cloud platforms with practical AI integration to deliver systems that work.
      </p>

      <div class="grid md:grid-cols-2 gap-12 mt-16">
        <div>
          <h2 class="text-2xl font-bold mb-4">Our Mission</h2>
          <p class="text-gray-600 leading-relaxed">
            To make enterprise-grade cloud infrastructure and AI capabilities accessible to businesses of all sizes. We believe technology should be an accelerator, not a bottleneck.
          </p>
        </div>
        <div>
          <h2 class="text-2xl font-bold mb-4">Our Approach</h2>
          <p class="text-gray-600 leading-relaxed">
            We start with your business goals, not the technology. Every solution we build is designed for production — reliable, maintainable, and cost-effective. No overengineering, no vendor lock-in.
          </p>
        </div>
      </div>

      <div class="mt-16">
        <h2 class="text-2xl font-bold mb-6">What We Believe</h2>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-1 bg-accent rounded-full flex-shrink-0"></div>
            <div>
              <h3 class="font-semibold text-lg">Infrastructure as Code</h3>
              <p class="text-gray-600">Every piece of infrastructure should be versioned, reproducible, and automated. Manual changes don't scale.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-1 bg-accent rounded-full flex-shrink-0"></div>
            <div>
              <h3 class="font-semibold text-lg">Security First</h3>
              <p class="text-gray-600">Security is not an afterthought. We build it into every layer — from IAM policies to network segmentation to secret management.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-1 bg-accent rounded-full flex-shrink-0"></div>
            <div>
              <h3 class="font-semibold text-lg">Practical AI</h3>
              <p class="text-gray-600">AI should solve real problems. We focus on implementations that deliver measurable business value, not demos.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
