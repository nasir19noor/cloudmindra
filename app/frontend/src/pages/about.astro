---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Cta from '../components/Cta.astro';

const beliefs = [
  {
    title: 'Infrastructure as Code',
    body: "Every piece of infrastructure should be versioned, reproducible, and automated. Manual changes don't scale.",
  },
  {
    title: 'Security First',
    body: 'Security is not an afterthought. We build it into every layer — from IAM policies to network segmentation to secret management.',
  },
  {
    title: 'Practical AI',
    body: 'AI should solve real problems. We focus on implementations that deliver measurable business value, not demos.',
  },
];
---

<Layout title="About Us" description="Learn about CloudMindra — our mission, values, and expertise in cloud and AI.">
  <section class="relative overflow-hidden px-6 pb-16 pt-[150px] md:pt-[180px]">
    <div class="dot-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1100px]">
      <p class="eyebrow mb-5">About</p>
      <h1 class="max-w-[820px] text-balance font-display text-[38px] font-light leading-[1.15] md:text-display-xl">
        We help businesses build cloud and AI systems that work.
      </h1>
      <p class="mt-6 max-w-[620px] text-body text-white/65 md:text-[16px]">
        CloudMindra is a cloud and AI solutions company focused on helping businesses build, deploy, and scale modern
        infrastructure. We combine deep expertise in cloud platforms with practical AI integration to deliver systems that work.
      </p>
    </div>
  </section>

  <section class="px-6 py-[60px]">
    <div class="mx-auto grid max-w-[1100px] gap-4 md:grid-cols-2">
      <div class="card p-8">
        <p class="eyebrow">Our mission</p>
        <p class="mt-6 font-display text-title font-light">Enterprise-grade, for every size of business</p>
        <p class="mt-3 text-body text-white/60">
          To make enterprise-grade cloud infrastructure and AI capabilities accessible to businesses of all sizes. We believe
          technology should be an accelerator, not a bottleneck.
        </p>
      </div>
      <div class="card p-8">
        <p class="eyebrow">Our approach</p>
        <p class="mt-6 font-display text-title font-light">Business goals first, technology second</p>
        <p class="mt-3 text-body text-white/60">
          Every solution we build is designed for production — reliable, maintainable, and cost-effective. No
          overengineering, no vendor lock-in.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 py-[90px]">
    <div class="mx-auto max-w-[1100px]">
      <SectionHeader eyebrow="Principles" title="What we believe." />
      <div class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-white/[0.06] ring-1 ring-white/[0.06] md:grid-cols-3">
        {beliefs.map((b, i) => (
          <div class="bg-ink p-8">
            <span class="font-sans text-[12px] font-medium text-brand">0{i + 1}</span>
            <h3 class="mt-8 font-display text-title font-light">{b.title}</h3>
            <p class="mt-3 text-body text-white/55">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Layout>
