---
import Layout from '../../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.cloudmindra.com';
const CURRENCIES = ['USD', 'IDR', 'SGD', 'MYR', 'EUR', 'GBP', 'AUD', 'JPY'];
---

<Layout title="Manage workspace" description="Workspace settings, team and invitations">
  <section class="px-6 pb-24 pt-36" data-api={API_URL} id="ws-admin">
    <div class="mx-auto max-w-[860px]">
      <a href="/portal" class="text-caption font-medium text-fg/60 hover:text-fg">← Back to portal</a>

      <p id="view-loading" class="mt-8 text-body text-fg/60">Loading…</p>

      <div id="view-denied" class="card mt-8 hidden space-y-3 p-8">
        <p class="eyebrow">Manage workspace</p>
        <p id="denied-msg" class="text-body text-fg/70">Only owners and admins can manage this workspace.</p>
      </div>

      <div id="view-admin" class="hidden">
        <div class="mt-6">
          <p class="eyebrow mb-3">Manage workspace</p>
          <h1 class="font-display text-display-sm font-light" id="ws-title"></h1>
          <p class="mt-2 text-body text-fg/60">You are <b id="ws-my-role"></b> of this workspace.</p>
        </div>

        <!-- General -->
        <section class="card mt-8 p-6">
          <p class="eyebrow">General</p>
          <form id="general-form" class="mt-5 grid gap-4 md:grid-cols-[1fr_180px_auto] md:items-end">
            <div>
              <label for="ws-name" class="mb-2 block text-caption font-medium text-fg/70">Workspace name</label>
              <input id="ws-name" name="name" required maxlength="100" class="field" />
            </div>
            <div>
              <label for="ws-currency" class="mb-2 block text-caption font-medium text-fg/70">Display currency</label>
              <select id="ws-currency" name="currency" class="field">
                {CURRENCIES.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
            <button type="submit" class="h-[46px] rounded-full bg-fg px-6 text-body font-medium text-canvas transition-opacity hover:opacity-90 disabled:opacity-60">
              Save
            </button>
          </form>
          <p id="general-msg" class="mt-3 hidden text-caption" role="status"></p>
        </section>

        <!-- Team -->
        <section class="card mt-4 p-6">
          <p class="eyebrow">Team <span id="team-seats" class="text-fg/45"></span></p>
          <p class="mt-2 text-caption text-fg/55">Everyone in this workspace can see its monitors and receives its alerts.</p>

          <form id="invite-form" class="mt-6">
            <div class="grid gap-3 md:grid-cols-[1.6fr_auto_auto]">
              <input name="email" type="email" required maxlength="254" placeholder="colleague@company.com" class="field" aria-label="Email address to invite" />
              <select name="role" class="field md:w-[150px]" aria-label="Role">
                <option value="member" selected>Member</option>
                <option value="viewer">Viewer</option>
                <option value="admin">Admin</option>
              </select>
              <button type="submit" class="h-[46px] rounded-full bg-fg px-6 text-body font-medium text-canvas transition-opacity hover:opacity-90 disabled:opacity-60">
                Send invite
              </button>
            </div>
          </form>
          <p id="team-msg" class="mt-3 hidden break-all text-caption" role="status"></p>

          <ul id="member-list" class="mt-6 divide-y divide-fg/[0.06] rounded-2xl ring-1 ring-fg/[0.08]"></ul>

          <div id="invite-block" class="mt-6 hidden">
            <p class="eyebrow">Pending invitations</p>
            <ul id="invite-list" class="mt-3 divide-y divide-fg/[0.06] rounded-2xl ring-1 ring-fg/[0.08]"></ul>
          </div>
        </section>

        <!-- Danger zone -->
        <section class="card mt-4 p-6 ring-red-200">
          <p class="eyebrow text-red-700">Danger zone</p>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-body font-medium">Leave this workspace</p>
              <p class="text-caption text-fg/55">You lose access to its monitors. A workspace always needs one owner.</p>
            </div>
            <button id="leave-btn" type="button" class="btn-secondary h-[36px] text-caption text-red-600">Leave</button>
          </div>
          <div id="delete-row" class="mt-5 hidden flex-wrap items-center justify-between gap-3 border-t border-fg/[0.08] pt-5">
            <div>
              <p class="text-body font-medium">Delete this workspace</p>
              <p class="text-caption text-fg/55">Removes every monitor, check history, member and invitation. This cannot be undone.</p>
            </div>
            <button id="delete-btn" type="button" class="h-[36px] rounded-full bg-red-600 px-5 text-caption font-medium text-white hover:bg-red-700">Delete workspace</button>
          </div>
          <p id="danger-msg" class="mt-3 hidden text-caption text-red-600" role="alert"></p>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { $, esc, createApi, errorText, ROLE_LABEL, canManageWorkspace, type Role } from '../../lib/portal';

  const api = createApi($('ws-admin').dataset.api as string);

  type Workspace = { id: string; name: string; currency: string; role: Role };
  type Member = { user_id: string; email: string; name: string | null; role: Role; is_self: boolean };
  type Invite = { id: string; email: string; role: string; expires_at: string };

  let ws: Workspace;
  let members: Member[] = [];
  let invites: Invite[] = [];
  const base = () => `/api/orgs/${encodeURIComponent(ws.id)}`;

  function view(name: 'loading' | 'denied' | 'admin') {
    for (const v of ['loading', 'denied', 'admin']) $(`view-${v}`).classList.toggle('hidden', v !== name);
  }

  function msg(id: string, text: string | null, ok = false) {
    const el = $(id);
    el.textContent = text ?? '';
    el.classList.toggle('hidden', !text);
    el.classList.toggle('text-red-600', !ok);
    el.classList.toggle('text-emerald-700', ok);
  }

  function renderHeader() {
    $('ws-title').textContent = ws.name;
    $('ws-my-role').textContent = ROLE_LABEL[ws.role].toLowerCase();
    $<HTMLInputElement>('ws-name').value = ws.name;
    $<HTMLSelectElement>('ws-currency').value = ws.currency;
    const owner = ws.role === 'owner';
    $('delete-row').classList.toggle('hidden', !owner);
    $('delete-row').classList.toggle('flex', owner);
  }

  // --- General ------------------------------------------------------------------
  $('general-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = (e.currentTarget as HTMLFormElement).querySelector('button')!;
    btn.disabled = true;
    msg('general-msg', null);
    const res = await api(base(), {
      method: 'PATCH',
      body: JSON.stringify({ name: $<HTMLInputElement>('ws-name').value.trim(), currency: $<HTMLSelectElement>('ws-currency').value }),
    }).catch(() => null);
    btn.disabled = false;
    if (!res?.ok) return msg('general-msg', await errorText(res, 'Could not save'));
    const saved = await res.json();
    ws = { ...ws, name: saved.name, currency: saved.currency };
    renderHeader();
    msg('general-msg', 'Saved.', true);
  });

  // --- Team ---------------------------------------------------------------------
  function renderTeam() {
    const iAmOwner = ws.role === 'owner';
    $('member-list').innerHTML = members
      .map((m) => {
        // Admins manage everyone below owner; only owners touch owners
        const editable = !m.is_self && (m.role !== 'owner' || iAmOwner);
        const roles: Role[] = iAmOwner ? ['owner', 'admin', 'member', 'viewer'] : ['admin', 'member', 'viewer'];
        const roleCell = editable
          ? `<select data-member="${esc(m.user_id)}" class="field h-[34px] w-[120px] py-0 text-[13px]" aria-label="Role for ${esc(m.email)}">
               ${roles.map((r) => `<option value="${r}" ${r === m.role ? 'selected' : ''}>${ROLE_LABEL[r]}</option>`).join('')}
             </select>`
          : `<span class="text-[13px] text-fg/70">${ROLE_LABEL[m.role]}</span>`;
        return `
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-body font-medium">${esc(m.name || m.email)}${m.is_self ? ' <span class="font-normal text-fg/50">(you)</span>' : ''}</p>
              <p class="truncate text-caption text-fg/55">${esc(m.email)}</p>
            </div>
            <div class="flex items-center gap-2">
              ${roleCell}
              ${editable ? `<button data-remove="${esc(m.user_id)}" class="btn-secondary h-[30px] px-3 text-[12px] text-red-600">Remove</button>` : ''}
            </div>
          </li>`;
      })
      .join('');

    $('invite-block').classList.toggle('hidden', !invites.length);
    $('invite-list').innerHTML = invites
      .map(
        (i) => `
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-body">${esc(i.email)}</p>
              <p class="text-caption text-fg/55">${esc(ROLE_LABEL[i.role] ?? i.role)} · expires ${esc(new Date(i.expires_at).toLocaleDateString())}</p>
            </div>
            <div class="flex gap-2">
              <button data-resend="${esc(i.id)}" class="btn-secondary h-[30px] px-3 text-[12px]">Resend</button>
              <button data-cancel="${esc(i.id)}" class="btn-secondary h-[30px] px-3 text-[12px] text-red-600">Cancel</button>
            </div>
          </li>`,
      )
      .join('');
  }

  async function loadTeam() {
    const [m, i] = await Promise.all([api(`${base()}/members`).catch(() => null), api(`${base()}/invitations`).catch(() => null)]);
    if (m?.ok) {
      const data = await m.json();
      members = data.members;
      $('team-seats').textContent = `· ${data.seats.used} of ${data.seats.limit} seats`;
    }
    invites = i?.ok ? await i.json() : [];
    renderTeam();
  }

  // When the email could not be delivered (e.g. SES sandbox), hand the inviter the link instead
  async function reportInvite(email: string, data: { email_sent?: boolean; invite_link?: string }, okText: string) {
    if (data.email_sent !== false || !data.invite_link) return msg('team-msg', okText, true);
    let copied = false;
    try {
      await navigator.clipboard.writeText(data.invite_link);
      copied = true;
    } catch {
      /* clipboard can be blocked; the link is shown below either way */
    }
    msg(
      'team-msg',
      `We couldn't email ${email}. ${copied ? 'The invitation link is copied to your clipboard — ' : ''}share this link with them: ${data.invite_link}`,
    );
  }

  const sendInvite = (email: string, role: string) =>
    api(`${base()}/invitations`, { method: 'POST', body: JSON.stringify({ email, role }) }).catch(() => null);

  $('invite-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const btn = form.querySelector('button')!;
    const data = new FormData(form);
    const email = String(data.get('email')).trim();
    btn.disabled = true;
    msg('team-msg', null);
    const res = await sendInvite(email, String(data.get('role')));
    btn.disabled = false;
    if (!res?.ok) return msg('team-msg', await errorText(res, 'Could not send the invitation'));
    (form.elements.namedItem('email') as HTMLInputElement).value = '';
    await reportInvite(email, await res.json(), `Invitation sent to ${email}.`);
    await loadTeam();
  });

  $('member-list').addEventListener('change', async (e) => {
    const select = (e.target as HTMLElement).closest<HTMLSelectElement>('select[data-member]');
    if (!select) return;
    msg('team-msg', null);
    const res = await api(`${base()}/members/${encodeURIComponent(select.dataset.member!)}`, {
      method: 'PATCH',
      body: JSON.stringify({ role: select.value }),
    }).catch(() => null);
    if (!res?.ok) msg('team-msg', await errorText(res, 'Could not change the role'));
    await loadTeam();
  });

  $('member-list').addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-remove]');
    if (!btn) return;
    const m = members.find((x) => x.user_id === btn.dataset.remove)!;
    if (!confirm(`Remove ${m.name || m.email} from ${ws.name}?`)) return;
    msg('team-msg', null);
    const res = await api(`${base()}/members/${encodeURIComponent(m.user_id)}`, { method: 'DELETE' }).catch(() => null);
    if (!res?.ok) msg('team-msg', await errorText(res, 'Could not remove the member'));
    await loadTeam();
  });

  $('invite-list').addEventListener('click', async (e) => {
    const resend = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-resend]');
    const cancel = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cancel]');
    const inv = invites.find((i) => i.id === (resend?.dataset.resend ?? cancel?.dataset.cancel));
    if (!inv) return;
    msg('team-msg', null);
    if (resend) {
      const res = await sendInvite(inv.email, inv.role);
      if (!res?.ok) return msg('team-msg', await errorText(res, 'Could not resend the invitation'));
      await reportInvite(inv.email, await res.json(), `A new invitation link was sent to ${inv.email}.`);
    } else {
      const res = await api(`${base()}/invitations/${encodeURIComponent(inv.id)}`, { method: 'DELETE' }).catch(() => null);
      if (!res?.ok) return msg('team-msg', await errorText(res, 'Could not cancel the invitation'));
    }
    await loadTeam();
  });

  // --- Danger zone ----------------------------------------------------------------
  $('leave-btn').addEventListener('click', async () => {
    const me = members.find((m) => m.is_self);
    if (!me || !confirm(`Leave ${ws.name}? You will lose access to its monitors.`)) return;
    msg('danger-msg', null);
    const res = await api(`${base()}/members/${encodeURIComponent(me.user_id)}`, { method: 'DELETE' }).catch(() => null);
    if (!res?.ok) return msg('danger-msg', await errorText(res, 'Could not leave the workspace'));
    location.href = '/portal';
  });

  $('delete-btn').addEventListener('click', async () => {
    const typed = prompt(`This permanently deletes "${ws.name}" and all its monitors. Type the workspace name to confirm.`);
    if (typed === null) return;
    if (typed.trim() !== ws.name) return msg('danger-msg', 'The name did not match. Nothing was deleted.');
    msg('danger-msg', null);
    const res = await api(base(), { method: 'DELETE' }).catch(() => null);
    if (!res?.ok) return msg('danger-msg', await errorText(res, 'Could not delete the workspace'));
    location.href = '/portal';
  });

  // --- Start ------------------------------------------------------------------------
  async function init() {
    const res = await api('/api/orgs').catch(() => null);
    if (!res?.ok) {
      location.href = '/portal';
      return;
    }
    const data = await res.json();
    const wanted = new URLSearchParams(location.search).get('org') ?? data.last_org_id;
    const found: Workspace | undefined = data.workspaces.find((w: Workspace) => w.id === wanted);
    if (!found) {
      $('denied-msg').textContent = 'This workspace was not found, or you are not a member of it.';
      return view('denied');
    }
    ws = found;
    if (!canManageWorkspace(ws.role)) {
      $('denied-msg').textContent = `Only owners and admins can manage ${ws.name}. You are a ${ROLE_LABEL[ws.role].toLowerCase()}.`;
      return view('denied');
    }
    renderHeader();
    view('admin');
    await loadTeam();
  }

  init();
</script>
