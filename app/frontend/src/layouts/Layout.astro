---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CloudMindra — Cloud & AI Solutions' } = Astro.props;
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.cloudmindra.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@300;400&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} | CloudMindra</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[100] focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-black"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script define:vars={{ API_URL }}>
      // Lightweight page-view tracking for the admin analytics dashboard
      if (navigator.doNotTrack !== '1' && !location.pathname.startsWith('/admin')) {
        fetch(`${API_URL}/api/analytics/track`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: location.pathname, referrer: document.referrer || null }),
          keepalive: true,
        }).catch(() => {});
      }
    </script>
  </body>
</html>
