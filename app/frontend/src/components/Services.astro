---
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/services';
---

<section id="services" class="scroll-mt-[90px] px-6 py-[90px] md:py-[120px]">
  <div class="mx-auto max-w-[1100px]">
    <SectionHeader
      eyebrow="What we do"
      title="End-to-end services for your cloud and AI stack."
      description="One team across infrastructure, data, AI, and security — so nothing falls between the cracks."
    />

    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a href={`/services#${service.slug}`} class="card group relative flex flex-col p-7 transition hover:bg-surface-2 hover:ring-white/[0.12]">
          <div
            class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            style="background:radial-gradient(closest-side, rgba(255,107,53,0.18), transparent);filter:blur(10px)"
            aria-hidden="true"
          >
          </div>
          <h3 class="relative text-title font-medium">{service.headline}</h3>
          <p class="relative mt-1 text-caption text-white/45">{service.title}</p>
          <p class="relative mt-5 text-body text-white/70">{service.summary}</p>
          <ul class="relative mt-6 space-y-2 border-t border-white/[0.06] pt-5">
            {service.features.map((f) => (
              <li class="flex items-center gap-2.5 text-[13.5px] text-white/60 transition-colors group-hover:text-white/80">
                <span class="text-brand/80">→</span>
                {f}
              </li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </div>
</section>
