---
const services = [
  {
    icon: '☁️',
    title: 'Cloud Infrastructure',
    description: 'AWS, GCP, and Azure architecture design, migration, and management.',
  },
  {
    icon: '🤖',
    title: 'AI & Machine Learning',
    description: 'Custom AI solutions, model deployment, and LLM integration.',
  },
  {
    icon: '🚀',
    title: 'DevOps & Automation',
    description: 'CI/CD pipelines, Infrastructure as Code, and container orchestration.',
  },
  {
    icon: '📊',
    title: 'Data Engineering',
    description: 'Data pipelines, analytics platforms, and data lake architecture.',
  },
  {
    icon: '🔒',
    title: 'Cloud Security',
    description: 'IAM strategy, compliance frameworks, and vulnerability assessment.',
  },
  {
    icon: '💡',
    title: 'Consulting',
    description: 'Cloud strategy, cost optimization, and architecture review.',
  },
];
---

<section class="py-20 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-4">What We Do</h2>
    <p class="text-gray-500 text-center mb-12 max-w-2xl mx-auto">
      End-to-end cloud and AI services to help you build, deploy, and scale with confidence.
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-4xl mb-4">{service.icon}</div>
          <h3 class="text-xl font-semibold mb-3">{service.title}</h3>
          <p class="text-gray-500 leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
