---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-primary text-white sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      Cloud<span class="text-accent">Mindra</span>
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-accent',
              currentPath === link.href ? 'text-accent' : 'text-gray-300',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/contact"
      class="hidden md:inline-block bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors"
    >
      Get Started
    </a>
  </nav>
</header>
