---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div>
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h2 class="max-w-[584px] text-balance font-display text-display-sm font-light md:text-display">{title}</h2>
  </div>
  {description && <p class="max-w-[360px] text-body text-fg/65 md:text-right">{description}</p>}
</div>
