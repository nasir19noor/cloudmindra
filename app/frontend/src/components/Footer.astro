---
import { services } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/[0.06] px-6 pb-10 pt-16">
  <div class="mx-auto max-w-[1100px]">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-display text-[19px] tracking-tight">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="10" stroke="#ff6b35" stroke-width="2.5"></circle>
            <circle cx="16" cy="16" r="3.5" fill="#fff"></circle>
          </svg>
          CloudMindra
        </a>
        <p class="mt-4 max-w-[300px] text-body text-white/50">
          Cloud and AI solutions to accelerate your business. We design, build, and manage modern infrastructure.
        </p>
      </div>
      <div>
        <p class="eyebrow mb-4">Services</p>
        <ul class="space-y-2.5 text-body">
          {services.slice(0, 4).map((s) => (
            <li><a href={`/services#${s.slug}`} class="text-white/60 transition-colors hover:text-white">{s.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-4">Company</p>
        <ul class="space-y-2.5 text-body">
          <li><a href="/about" class="text-white/60 transition-colors hover:text-white">About</a></li>
          <li><a href="/services" class="text-white/60 transition-colors hover:text-white">Services</a></li>
          <li><a href="/contact" class="text-white/60 transition-colors hover:text-white">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-4">Contact</p>
        <ul class="space-y-2.5 text-body">
          <li><a href="mailto:hi@cloudmindra.com" class="text-white/60 transition-colors hover:text-white">hi@cloudmindra.com</a></li>
          <li><a href="https://wa.me/6285288358561" target="_blank" rel="noopener" class="text-white/60 transition-colors hover:text-white">WhatsApp +62 852-8835-8561</a></li>
          <li><a href="/contact" class="text-white/60 transition-colors hover:text-white">Get in touch</a></li>
        </ul>
      </div>
    </div>

    <p
      class="pointer-events-none mt-16 select-none text-center font-display text-[14vw] font-light leading-none tracking-tight text-white/[0.04] md:text-[150px]"
      aria-hidden="true"
    >
      CloudMindra
    </p>

    <div class="mt-6 flex flex-col items-center justify-between gap-3 border-t border-white/[0.06] pt-6 text-caption text-white/40 md:flex-row">
      <span>&copy; {year} CloudMindra. All rights reserved.</span>
      <span>Cloud · AI · DevOps</span>
    </div>
  </div>
</footer>
