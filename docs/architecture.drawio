&lt;/b&gt;&lt;br&gt;managed login&lt;br&gt;(identity_provider=Google skips the page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="504" y="140" width="210" height="150" as="geometry"/></mxCell><mxCell id="p2_7" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_4" target="p2_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_8" value="&lt;b&gt;Google&lt;/b&gt;&lt;br&gt;user consents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="736" y="140" width="210" height="150" as="geometry"/></mxCell><mxCell id="p2_9" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_6" target="p2_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_10" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;GET /api/auth/callback&lt;br&gt;check state · exchange code&lt;br&gt;(client secret + verifier)&lt;br&gt;verify ID token (JWKS, aud, iss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="968" y="140" width="210" height="150" as="geometry"/></mxCell><mxCell id="p2_11" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_8" target="p2_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_12" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;upsert users · seed ADMIN_EMAIL&lt;br&gt;set cm_session&lt;br&gt;(HMAC, httpOnly, 12 h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="210" height="150" as="geometry"/></mxCell><mxCell id="p2_13" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_10" target="p2_12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_14" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;redirect to next&lt;br&gt;/api/auth/me · /api/admin/me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1432" y="140" width="210" height="150" as="geometry"/></mxCell><mxCell id="p2_15" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_12" target="p2_14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_16" value="Admin check on every request: users.is_admin in Postgres, so revoking is immediate. Non-members of a workspace get 404 (planned)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1610" height="40" as="geometry"/></mxCell><mxCell id="p2_17" value="Logout: /api/auth/logout clears cm_session and calls Cognito /logout." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1610" height="40" as="geometry"/></mxCell><mxCell id="p2_18" value="2. Customer connects an AWS account (planned — role + External ID only, no stored keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1660" height="440" as="geometry"/></mxCell><mxCell id="p2_19" value="&lt;b&gt;Workspace admin&lt;/b&gt;&lt;br&gt;Connections → Add AWS account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="210" height="100" as="geometry"/></mxCell><mxCell id="p2_20" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;cloud_connection (pending)&lt;br&gt;random ExternalId per workspace&lt;br&gt;CloudFormation quick-create URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="290" y="570" width="240" height="100" as="geometry"/></mxCell><mxCell id="p2_21" value="&lt;b&gt;Customer AWS console&lt;/b&gt;&lt;br&gt;stack creates CloudMindraReadOnly&lt;br&gt;trusts CloudMindraHub + ExternalId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="570" y="570" width="240" height="100" as="geometry"/></mxCell><mxCell id="p2_22" value="&lt;b&gt;Role ARN&lt;/b&gt;&lt;br&gt;returned to the portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="850" y="570" width="200" height="100" as="geometry"/></mxCell><mxCell id="p2_23" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;verify job: AssumeRole → probe APIs&lt;br&gt;store capabilities · status=verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1090" y="570" width="250" height="100" as="geometry"/></mxCell><mxCell id="p2_24" value="&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;cost pulls · security scans&lt;br&gt;via provider interface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1380" y="570" width="250" height="100" as="geometry"/></mxCell><mxCell id="p2_25" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_19" target="p2_20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_26" value="2 open link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_20" target="p2_21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_27" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_21" target="p2_22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_28" value="4 verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_22" target="p2_23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_29" value="5 jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_23" target="p2_24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_30" value="&lt;b&gt;Contabo worker&lt;/b&gt;&lt;br&gt;X.509 cert (CloudMindra private CA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="200" y="750" width="240" height="80" as="geometry"/></mxCell><mxCell id="p2_31" value="&lt;b&gt;IAM Roles Anywhere&lt;/b&gt;&lt;br&gt;trust anchor + profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;dash